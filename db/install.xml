<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/learninganalytics/db" VERSION="2026010500" COMMENT="XMLDB file for block_learninganalytics"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

    <TABLES>
        <TABLE NAME="block_la_todos_done" COMMENT="Vom Nutzer als erledigt markierte ToDos im Learning-Analytics-Block">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="User-ID"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Kursmodul-ID"/>
                <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Zeitpunkt der Erledigung"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="user_cmid_uix" UNIQUE="true" FIELDS="userid, cmid"/>
            </INDEXES>
        </TABLE>
    </TABLES>

</XMLDB>

